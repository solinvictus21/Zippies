
//routineset <time_step>
//  where:
//       time_step - the amount of time in milliseconds to multiply every timing encountered in the routine
//
//point <point_alias> <x> <y> <o>
//  defines a point as x/y/o coordinates
//  any point can be executed as either a relative movement or an absolute position
//
//path <path_alias>
//  defines a path for which each subsequent point is relative to the starting point of the entire path
//  each line of the path should be one of the following formats:
//      <time_factor> <alias>
//  or:
//      <time_factor> <x> <y> <o>
//  where:
//       time_factor - the multiple of time for each step of the path
//       alias - the alias of the point or path to include into this path
//       x/y/o - the absolute position of each point in the path
//
//rpath <path_alias>
//  defines a path for which each subsequent point is relative to the previous point in the path
//  the format of each line is the same as the path, but each step of the path will be treated as
//  movement commands relative to the previous position instead of absolute target positions
//
//routine <starting_position> <UUID>
//  defines an entire routine for an individual Zippy to execute
//  where:
//        starting_position - an absolute position specified as x/y/o coordinates or an a point alias
//        UUID - the UUID of the Zippy to execute this routine
//move
//  move <point_alias>
//  move <x> <y> <o>
//watch
//  watch <point_alias>
//  watch <x> <y> <o>
//mimic
//  mimic <point_alias>
//  mimic <x> <y> <o>
//forward
//  forward <time_factor> <alias>
//  forward <time_factor> <x> <y> <o>
//reverse
//  reverse <time_factor> <alias>
//  reverse <time_factor> <x> <y> <o>
//hold
//  hold <time_factor> <point_alias>
//  hold <time_factor> <x> <y> <o>

routineset 100

//named points
point RedStart                 160       0       0
point OrangeStart               80       0       0
point GreenStart                 0       0       0
point BlueStart                -80       0       0
point PurpleStart             -160       0       0

//relative large movements
point LargeQuarterLeft        -300     300      90
point LargeQuarterRight        300     300      90
point LargeHalfLeft           -600       0     180
point LargeHalfRight           600       0     180
point LargeRightLeft           600     600       0
point LargeLeftRight          -600     600       0

//relative medium movements
point MediumQuarterLeft       -120     120     -90
point MediumLeftRight         -240     240     -90
point MediumQuarterRight       120     120      90


//path definitions
rpath ThreeQuarterHalfRight
            2  LargeHalfRight
            1  LargeQuarterRight
rpath FigureEightQuarters
            1  LargeQuarterRight
            1  LargeQuarterRight
            2  LargeRightLeft
            1  LargeQuarterLeft
            1  LargeQuarterLeft
            2  LargeLeftRight
rpath FigureEightHalves
            2  LargeHalfRight
            2  LargeRightLeft
            2  LargeHalfLeft
            2  LargeLeftRight
rpath DoubleFigureEight
            1  LargeQuarterRight
            1  FigureEightQuarters
            1  FigureEightHalves
            1  ThreeQuarterHalfRight
rpath MediumFigureEight
            1  MediumQuarterLeft
            1  MediumQuarterLeft
            1  MediumQuarterLeft
            1  MediumQuarterLeft
            1  MediumQuarterRight
            1  MediumQuarterRight
            1  MediumQuarterRight
            1  MediumQuarterRight
path StarPointRight
//45
            2      45      45      90
//60
            2     105       0     180
//75
            2      30     -75     -90
//90
            2     -60       0       0
//105
            2      45     105      90
//90
            2     135       0     180
//75
            2      60     -75     -90
//60
            2       0       0       0


//RED ROUTINE
routine        RedStart                  3BCD3F11504B3233372E3120FF022719
forward    12  DoubleFigureEight
hold       12
reverse    12  DoubleFigureEight
hold       12

//watch green move
watch          GreenStart
forward     9  MediumFigureEight

//switch back to movement mode and hold
move           RedStart
hold       12

//watch blue move
watch          BlueStart
forward     9  MediumFigureEight

//switch back to movement mode and hold
move           RedStart
hold       12
//END RED ROUTINE


//ORANGE ROUTINE - TBD
routine        OrangeStart               9E104EE45052534A352E3120FF091527
forward    12  DoubleFigureEight
hold       12
reverse    12  DoubleFigureEight
hold       12
//END ORANGE ROUTINE


//GREEN ROUTINE
routine        GreenStart                82C95D68504D5257352E3120FF152F28
forward    12  DoubleFigureEight
hold       12
reverse    12  DoubleFigureEight
hold       12

//move while others watch
move           GreenStart
forward     9  MediumFigureEight
hold       12

//watch blue move
watch          BlueStart
forward     9  MediumFigureEight

//switch back to movement mode and hold
move           GreenStart
hold       12
//END GREEN ROUTINE

//BLUE ROUTINE
routine        BlueStart                 8A95E7ED504E5452372E3120FF181D37
forward    12  DoubleFigureEight
hold       12
reverse    12  DoubleFigureEight
hold       12

//watch green move
watch          GreenStart
forward     9  MediumFigureEight

//switch back to movement mode and hold
move           BlueStart
hold       12

//move while others watch
forward     9  MediumFigureEight
hold       12
//END BLUE ROUTINE

//PURPLE ROUTINE - TBD
routine        PurpleStart               5A252B0E5052534A352E3120FF0C3222
forward    12  DoubleFigureEight
hold       12
reverse    12  DoubleFigureEight
hold       12
//END PURPLE ROUTINE
