
include RoutineBase

path BlueChorus
         Beats4
       Beats1_5         HalfFlower4      -100       100
         Beats2

         Beats1
       Beats1_5         HalfFlower4       100      -100
         Beats5

//BLUE ROUTINE
routine BlueStart
     //intro
//         Beats1             Intro30       100       100

     //first verse
              1    BlueFirstVerse72         1         1

     //chorus
              1          BlueChorus         1         1

     //bridge to second verse
         Beats6

     //second verse
              1   BlueSecondVerse72         1         1

     //chorus
              1          BlueChorus         1         1

     //bridge to third verse
         Beats9

     //push to third verse
         Beats12

     //third verse
              1    BlueFirstVerse72         1         1

     //chorus
              1          BlueChorus         1         1

     //outro
        Beats12
        Beats12

//END BLUE ROUTINE
