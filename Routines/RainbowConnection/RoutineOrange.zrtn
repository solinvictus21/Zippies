
include RoutineBase

path OrangeChorus
         Beats1
       Beats1_5         HalfFlower4      -100      -100
         Beats5

         Beats4
       Beats1_5         HalfFlower4       100       100
         Beats2

//ORANGE ROUTINE
routine OrangeStart
     //intro
//         Beats1             Intro30       100       100

     //first verse
              1  OrangeFirstVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //bridge to second verse
         Beats6

     //second verse
              1 OrangeSecondVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //bridge to third verse
         Beats9

     //push to third verse
        Beats12

     //third verse
              1  OrangeFirstVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //outro
        Beats12
        Beats12

//END ORANGE ROUTINE
