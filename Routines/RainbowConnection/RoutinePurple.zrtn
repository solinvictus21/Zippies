
include RoutineBase

path PurpleChorus
         Beats5
       Beats1_5         HalfFlower4      -100      -100
         Beats1

       Beats1_5         HalfFlower4       100       100
         Beats6


//PURPLE ROUTINE
routine PurpleStart
     //intro
//         Beats1             Intro30       100       100

     //first verse
              1  PurpleFirstVerse72         1         1

     //chorus
              1        PurpleChorus         1         1

     //bridge to second verse
         Beats6

     //second verse
              1 PurpleSecondVerse72         1         1

     //chorus
              1        PurpleChorus         1         1

     //bridge to third verse
         Beats9

     //push to third verse
         Beats12

     //third verse
              1  PurpleFirstVerse72         1         1

     //chorus
              1        PurpleChorus         1         1

     //outro
        Beats12
        Beats12

//END URPLE ROUTINE

