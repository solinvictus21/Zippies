//PURPLE ROUTINE
routine              PurpleStart               5A252B0E5052734A352E3120FF0C3222

              1      Intro

     //first verse
              1      PurpleVerse1

     //chorus
              1      PurpleChorus

     //bridge to second verse
         Beats6

     //second verse
              1      PurpleVerse1

     //chorus
              1      PurpleChorus

     //bridge to third verse
         Beats9

     //push to third verse
         Beats6
         Beats6

     //third verse
              1      PurpleVerse1

     //chorus
