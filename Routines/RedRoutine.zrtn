     //push to third verse
         Beats6
         Beats6

     //third verse
              1      YellowVerse1

     //chorus
              1      YellowChorus

     //outro
        Beats12
        Beats12

//END YELLOW ROUTINE


//GREEN ROUTINE
routine              GreenStart                82C95D68504D5277352E3120FF152F28

              1      Intro

     //first verse
              1      GreenVerse1

     //chorus
              1      GreenChorus

     //bridge to second verse
         Beats6

     //second verse
              1      GreenVerse1

     //chorus
              1      GreenChorus

     //bridge to third verse
         Beats9

     //push to third verse
         Beats6
         Beats6

     //third verse
              1      GreenVerse1

     //chorus
              1      GreenChorus

     //outro
        Beats12
        Beats12

//END GREEN ROUTINE


//BLUE ROUTINE
routine              BlueStart                 8A95E7ED504E5452372E3120FF181D37

              1      Intro

     //first verse
              1      BlueVerse1

     //chorus
              1      BlueChorus

     //bridge to second verse
         Beats6

     //second verse
              1      BlueVerse1

     //chorus
              1      BlueChorus

     //bridge to third verse
         Beats9

     //push to third verse
         Beats6
         Beats6

     //third verse
              1      BlueVerse1

     //chorus
              1      BlueChorus

     //outro
