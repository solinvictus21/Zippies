
//timing <timing_alias> <timing>
//  defines a named timing with a value in milliseconds that can be referenced by name wherever a timing is expected
//
//point <point_alias> <x> <y> <o>
//  defines a named point as x/y/o coordinates where x/y are in millimeters and o is is the target orientation in
//  degrees; coordinates are relative to the current anchor position
//
//path <path_alias>
//  defines a path to follow; each point of the path should be one of the following formats:
//      <time_factor> <flags> <point_name>
//  or:
//      <time_factor> <flags> <path_name>
//  or:
//      <time_factor> <flags> <x> <y> <o>
//  where:
//       time_factor - the multiple of time for each step of the path
//       flags - any combination of four possible flags as described below
//       alias - the alias of the point or path to include into this path
//       x/y/o - the absolute position of each point in the path
//  flags:
//       w: weigh anchor before moving (specified positions are assumed to be absolute positions wrt the origin)
//       d: drop anchor after moving (subsequent positions after movement will be relative to final position of
//          the specified movement)
//       x: reverse x position
//       y: reverse y position
//
//routine <starting_position> <UUID>
//  defines an entire routine for an individual Zippy to execute
//  where:
//        starting_position - an absolute position specified as x/y/o coordinates or a point alias
//        UUID - the UUID identify of the Zippy that should execute this routine
//

//named timings
timing Beats1                  522
timing Beats1_5                783
timing Beats2                 1044
timing Beats2_5               1305
timing Beats3                 1566
timing Beats3_5               1827
timing Beats4                 2088
timing Beats5                 2610
timing Beats6                 3132
timing Beats7                 3654
timing Beats8                 4176
timing Beats9                 4698
timing Beats12                6264

//named points
point RedStart                 250       0       0
point OrangeStart              150       0       0
point YellowStart               50       0       0
point GreenStart               -50       0       0
point BlueStart               -150       0       0
point PurpleStart             -250       0       0

point CirclePosition1           75    -130      60
point CirclePosition3           75     130     -60
point CirclePosition4          -75     130      60
point CirclePosition6          -75    -130     -60

//named path definitions
path IntroFirstHalf
         Beats1        50      50      90
         Beats1       100       0     180
         Beats1        50     -50     -90
         Beats1         0       0       0
         Beats5

path IntroSecondHalf
         Beats1        50      50      90
         Beats1       100       0     180
         Beats1
         Beats1        50      50      90
         Beats1         0       0       0
         Beats1

path Intro
//first half; 6 measures; 18 beats
              1      IntroFirstHalf
              1   x  IntroFirstHalf
//second half; 4 measures; 12 beats
              1      IntroSecondHalf
              1   x  IntroSecondHalf

//forward right half circle; pause; reverse; pause
path DoSeeDo
              1        50      50      90
              1       100       0     180
              1
              1        50     -50     -90
              1         0       0       0
              1

path DoSeeDo2
         Beats1      DoSeeDo
         Beats1    y DoSeeDo

path HalfFlower
              1       100     100     135
              1         0       0     -90
              1      -100    -100     135
              1         0       0       0

path CircleHalf50
         Beats1        50      50      90
         Beats1       100       0     180

path CircleThreeQuarter50
         Beats1        50      50      90
         Beats1       100       0     180
         Beats1        50     -50     -90

path Circle50
         Beats1        50      50      90
         Beats1       100       0     180
         Beats1        50     -50     -90
         Beats1         0       0       0

path FullCircle100
         Beats2       100     100      90
         Beats1
         Beats2       200       0     180
         Beats1
         Beats2       100    -100     -90
         Beats1
         Beats2         0       0       0
         Beats1

path CircleCounterClockwise
         Beats2       -75     130     -60
         Beats1
         Beats2      -186     108     150
         Beats1
         Beats2      -300       0       0
         Beats1
         Beats2      -186    -108    -150
         Beats1
         Beats2       -75    -130      60
         Beats1
         Beats2         0       0       0
         Beats1

path StepForwardBack
         Beats1        30      52      60
         Beats1         0       0       0
         Beats1

path RedChorus
     //someday we'll find it, the Rainbow Connection
     //12 beats
       Beats1_5   x  HalfFlower
         Beats6

     //the lovers, the dreamers and me
     //12 beats
         Beats5
       Beats1_5    y HalfFlower
         Beats1

path OrangeChorus
         Beats1
       Beats1_5   xy HalfFlower
         Beats5

         Beats4
       Beats1_5      HalfFlower
         Beats2

path YellowChorus
         Beats2
       Beats1_5   x  HalfFlower
         Beats4

         Beats3
       Beats1_5    y HalfFlower
         Beats3

path GreenChorus
         Beats3
       Beats1_5   xy HalfFlower
         Beats3

         Beats2
       Beats1_5      HalfFlower
         Beats4

path BlueChorus
         Beats4
       Beats1_5   x  HalfFlower
         Beats2

         Beats1
       Beats1_5    y HalfFlower
         Beats5

path PurpleChorus
         Beats5
       Beats1_5   xy HalfFlower
         Beats1

       Beats1_5      HalfFlower
         Beats6

path RedVerse1
     //why are there so many
     //songs about rainbows
     //12 beats
              1   xy DoSeeDo2

     //and what's on the other side
     //12 beats
              1   x  FullCircle100

     //rainbows are visions, but only illusions
     //and rainbows have nothing to hide
     //3 beats into circle position
         Beats2 wd   CirclePosition1
         Beats1
     //18 beats around the circle
              1      CircleCounterClockwise
     //3 beats back out of circle position
         Beats2 wd   RedStart
         Beats1

     //so we've been told and some choose to believe it
     //12 beats
         Beats2
       Beats1_5      HalfFlower
         Beats1
              1   x  StepForwardBack

     //but I know they're wrong. wait and see
     //12 beats
       Beats1_5   xy HalfFlower
         Beats3
              1    y StepForwardBack

path OrangeVerse1
              1      DoSeeDo2

//SPICE THIS UP
         Beats6
         Beats6

         Beats3
              1      CircleCounterClockwise
         Beats2 wd   OrangeStart
         Beats1

         Beats1
       Beats1_5    y HalfFlower
         Beats2

              1   xy StepForwardBack

         Beats1
       Beats1_5   x  HalfFlower
         Beats2

              1      StepForwardBack

path YellowVerse1
              1   xy DoSeeDo2

              1    y FullCircle100

         Beats2 wd   CirclePosition3
         Beats1
              1      CircleCounterClockwise
         Beats2 wd   YellowStart
         Beats1

       Beats1_5      HalfFlower
         Beats3

              1   x  StepForwardBack

         Beats2
       Beats1_5   xy HalfFlower
         Beats1

              1    y StepForwardBack

path GreenVerse1
              1      DoSeeDo2

              1   xy FullCircle100

         Beats2 wd   CirclePosition4
         Beats1
              1   xy CircleCounterClockwise
         Beats2 wd   GreenStart
         Beats1

         Beats2
       Beats1_5    y HalfFlower
         Beats1

              1   xy StepForwardBack

       Beats1_5   x  HalfFlower
         Beats3

              1      StepForwardBack

path BlueVerse1
              1   xy DoSeeDo2

//SPICE THIS UP
         Beats6
         Beats6

         Beats3
              1   xy CircleCounterClockwise
         Beats2 wd   BlueStart
         Beats1

         Beats1
       Beats1_5      HalfFlower
         Beats2

              1   x  StepForwardBack

         Beats1
       Beats1_5   xy HalfFlower
         Beats2

              1    y StepForwardBack

path PurpleVerse1
              1      DoSeeDo2

              1      FullCircle100

         Beats2 wd   CirclePosition6
         Beats1
              1   xy CircleCounterClockwise
         Beats2 wd   PurpleStart
         Beats1

       Beats1_5    y HalfFlower
         Beats3

              1   xy StepForwardBack

         Beats2
       Beats1_5   x  HalfFlower
         Beats1

              1      StepForwardBack

//RED ROUTINE
routine              RedStart                  4AC2987350533748392E3120FF192F33

              1      Intro

     //first verse
              1      RedVerse1

     //chorus
              1      RedChorus

     //bridge to second verse
         Beats6

     //second verse
              1      RedVerse1

     //chorus
              1      RedChorus

     //bridge to third verse
     //all of us under its spell
     //3 measures; 9 beats
         Beats9

     //we know that it's probably magic
     //the "push"; position for the final verse
     //4 measures; 12 beats
         Beats6
         Beats6

     //third verse
              1      RedVerse1

     //chorus
              1      RedChorus

     //outro
        Beats12
        Beats12

//END RED ROUTINE


//ORANGE ROUTINE
routine              OrangeStart               9E104EE45052734A352E3120FF091527

              1      Intro

     //first verse
              1      OrangeVerse1

     //chorus
              1      OrangeChorus

     //bridge to second verse
         Beats6

     //second verse
              1      OrangeVerse1

     //chorus
              1      OrangeChorus

     //bridge to third verse
         Beats9

     //push to third verse
         Beats6
         Beats6

     //third verse
              1      OrangeVerse1

     //chorus
              1      OrangeChorus

     //outro
        Beats12
        Beats12

//END ORANGE ROUTINE


//YELLOW ROUTINE
routine              YellowStart               4596FFCD50533748392E3120FF19103F

              1      Intro

     //first verse
              1      YellowVerse1

     //chorus
              1      YellowChorus

     //bridge to second verse
         Beats6

     //second verse
              1      YellowVerse1

     //chorus
              1      YellowChorus

     //bridge to third verse
