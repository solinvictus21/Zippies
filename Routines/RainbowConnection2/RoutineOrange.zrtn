
include RoutineBase

path OrangeTest
              1             Circle4         1         1
              1             Circle4         1         1
              1             Circle4         1         1
              1             Circle4         1         1

path OrangeChorus
         Beats1
       Beats1_5         HalfFlower4      -100      -100
         Beats5

         Beats4
       Beats1_5         HalfFlower4       100       100
         Beats2

path OrangeFirstVerse72
         Beats1           DoSeeDo12        50        50

//SPICE THIS UP
         Beats12

         Beats3
         Beats1       CircleDance18         1         1
         Beats3

         Beats1
       Beats1_5         HalfFlower4       100      -100
         Beats2
         Beats1    StepForwardBack3        -1        -1

         Beats1
       Beats1_5         HalfFlower4      -100       100
         Beats2
         Beats1    StepForwardBack3         1         1

//ORANGE ROUTINE
routine OrangeStart
     //intro
//         Beats1             Intro30        50        50
//       Beats0_5           Intro2_30        50        50
       Beats1_5          OrangeTest      -150       150

     //first verse
              1  OrangeFirstVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //bridge to second verse
         Beats6

     //second verse
              1  OrangeFirstVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //bridge to third verse
         Beats9

     //push to third verse
        Beats12

     //third verse
              1  OrangeFirstVerse72         1         1

     //chorus
              1        OrangeChorus         1         1

     //outro
        Beats12
        Beats12

//END ORANGE ROUTINE
