
include RoutineBase

point GreenCircleStart          -25       130        60

path GreenChorus
         Beats3
       Beats1_5         HalfFlower4      -100      -100
         Beats3

         Beats2
       Beats1_5         HalfFlower4       100       100
         Beats4

path GreenFirstVerse72
         Beats1           DoSeeDo12        50        50

         Beats1        FullCircle12      -100      -100

         Beats2    GreenCircleStart
         Beats1
         Beats1       CircleDance18        -1        -1
         Beats3

         Beats2
       Beats1_5         HalfFlower4       100      -100
         Beats1
         Beats1    StepForwardBack3        -1        -1


       Beats1_5         HalfFlower4      -100       100
         Beats3
         Beats1    StepForwardBack3         1         1

//GREEN ROUTINE
routine GreenStart
     //intro
//         Beats1             Intro30        50        50
       Beats0_5           Intro2_30        50        50

     //first verse
              1   GreenFirstVerse72         1         1

     //chorus
              1         GreenChorus         1         1

     //bridge to second verse
         Beats6

     //second verse
              1   GreenFirstVerse72         1         1

     //chorus
              1         GreenChorus         1         1

     //bridge to third verse
         Beats9

     //push to third verse
        Beats12

     //third verse
              1   GreenFirstVerse72         1         1

     //chorus
              1         GreenChorus         1         1

     //outro
        Beats12
        Beats12

//END GREEN ROUTINE
