         Beats4
         Beats1         0     100       0
         Beats1       -50     150     -90
         Beats3      -350     150     -90
         Beats3

//         Beats2  d      0     100       0
              1      Verse2Follow

              1      Verse2FigureEight

              1      Verse2SpiralInOut

              1      Verse2Circle
              1      Verse2Circle

         Beats1 w     -64      64     -90
         Beats1      -164      64     -90
         Beats1      -192       0     180
         Beats1      -164     -64      90
         Beats2 wd   BlueStart
         Beats4

path PurpleVerse2
//              1      Verse2RightStart
         Beats1
         Beats1         0     100       0
         Beats1       -50     150     -90
         Beats4      -450     150     -90
         Beats5

//         Beats4  d      0     200       0
              1      Verse2Follow

              1      Verse2FigureEight

              1      Verse2SpiralInOut

              1      Verse2Circle
              1      Verse2Circle

         Beats6 wd   PurpleStart
         Beats2

path RedVerse3
     //have you been half asleep
     //and have you heard voices
     //12 beats
        Beats12

     //I've heard them calling my name
     //12 beats
        Beats12

     //is this the sweet sound
     //that calls the young sailors
     //12 beats
        Beats12

     //the voice might be one and the same
     //12 beats
        Beats12

     //I've heard it too many times to ignore it
     //12 beats
        Beats12

     //it's something that I'm supposed to be
     //12 beats
        Beats12

path OrangeVerse3
        Beats12
        Beats12
        Beats12
        Beats12
        Beats12
        Beats12

path YellowVerse3
        Beats12
